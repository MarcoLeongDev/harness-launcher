{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Launcher",
  "version": "0.1.72",
  "identifier": "ai.dsh.launcher",
  "build": {
    "beforeDevCommand": "node scripts/prepare.mjs",
    "devUrl": "http://127.0.0.1:3080",
    "beforeBuildCommand": "node scripts/prepare.mjs",
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "resources/tray",
      "resources/npm",
      "resources/bootstrap-icons",
      "resources/brand",
      "resources/settings.html",
      "resources/overlay.js",
      "resources/stopped.html"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
