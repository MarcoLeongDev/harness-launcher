{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness Launcher",
  "version": "0.1.100",
  "identifier": "ai.dsh.launcher",
  "build": {
    "beforeDevCommand": "node scripts/prepare.mjs",
    "devUrl": "http://127.0.0.1:3080",
    "beforeBuildCommand": "node scripts/prepare.mjs",
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' dsh-ui: data:; connect-src 'self' dsh-ui:; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "resources/tray",
      "resources/npm",
      "resources/bootstrap-icons",
      "resources/brand",
      "resources/settings.html",
      "resources/settings.css",
      "resources/settings.js",
      "resources/overlay.js",
      "resources/stopped.html",
      "resources/stopped.css",
      "resources/stopped.js",
      "resources/locales"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
