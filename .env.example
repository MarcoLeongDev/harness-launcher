# Harness Launcher — example environment configuration
# Copy to .env (ignored by .gitignore) and fill with real values.
# Never commit your real .env.

# Where the launcher keeps settings, logs and the harness runtime.
# Defaults to ~/Library/Application Support/ai.dsh.launcher when unset.
DSH_HOME=/Users/your-user/.dsh
LOG_MAX_BYTES=2097152

# Example engine token (not used; the engine prints a per-process token at boot)
# ENGINE_TOKEN=replace-with-your-own
